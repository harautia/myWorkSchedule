PORT=3003

DATABASE_URL=postgres://youruser@localhost:5432/myworkschedule
TEST_DATABASE_URL=postgres://youruser@localhost:5432/myworkschedule_test
SESSION_SECRET=replace-with-a-long-random-string

# Optional: email for invitations and password reset (any SMTP server).
# Without it, managers get invitation links to pass on themselves.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# EMAIL_FROM=myWorkSchedule <schedule@example.com>
# Public address of the app, used in links in emails.
# APP_URL=http://localhost:5173
