  "license": "MIT",
  "description": "Backend for the bar work shift schedule",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "supertest": "^7.3.0"
  }
