# Settings for running myWorkSchedule with docker compose.
# Copy to .env and fill in. Never commit .env.
# Full reference: https://harautia.github.io/myWorkSchedule/self-hosting/configuration/

# --- Required ---

# Password of the bundled PostgreSQL database. Any long random string:
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login sessions. At least 32 random characters:
#   openssl rand -hex 32
# Changing it logs everyone out.
SESSION_SECRET=

# --- Email (optional) ---

# For invitations and "forgot password". Any SMTP server works, e.g. your email
# provider's or a service like Postmark, Mailgun or Amazon SES. Without it, managers
# get invitation links to pass on themselves, and "forgot password" is hidden.
#   SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
# Sender of the emails.
EMAIL_FROM=
# Public address of the app, used in links in emails, e.g. https://schedule.yourbar.com
APP_URL=

# --- Shown in the app footer (optional) ---

# Who runs this copy, e.g. your bar or company.
APP_OPERATOR_NAME=
# Where users can contact you.
APP_CONTACT_EMAIL=
# Link to your privacy policy.
APP_PRIVACY_URL=
# Link to the source code of the version you run. If you change the code,
# point this to your own repository (required by the AGPL licence).
APP_SOURCE_URL=https://github.com/harautia/myWorkSchedule

# --- Advanced (optional) ---

# Image version to run, e.g. 0.1.0. "latest" follows new releases.
MYWORKSCHEDULE_VERSION=latest
# Address and port the app listens on, on this machine. Keep 127.0.0.1 when a
# reverse proxy on the same machine handles HTTPS.
APP_BIND=127.0.0.1
APP_PORT=3003
# Only for testing without HTTPS (e.g. http://localhost): sessions don't work
# over plain HTTP otherwise. Never set to false on a real installation.
# COOKIE_SECURE=false
# self-hosted (default) or hosted (the official hosted service only).
# DEPLOYMENT_MODE=self-hosted
# Let anyone create a bar from the login page ("Create an account"). Off by
# default: the admin creates bars. If you turn it on, also set SMTP_URL (so new
# owners confirm their email) and preferably the Turnstile keys below.
# ALLOW_SIGNUP=false
# Cloudflare Turnstile bot check on the sign-up form (free; both keys from
# the Cloudflare dashboard).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
